# Absolute site URL used for canonical links, the sitemap and Open Graph.
# No trailing slash. Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Email delivery stays off until RESEND_API_KEY and CONTACT_FROM_EMAIL are set.
# The route always addresses harrisskaf@gmail.com. Do not commit a real key.
#
# RESEND_API_KEY — API key from https://resend.com (starts with re_)
RESEND_API_KEY=
# CONTACT_FROM_EMAIL — verified sender at Resend.
# Plain address or "ORGANEXT <hello@your-domain>".
CONTACT_FROM_EMAIL=
